  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "During the players turn and after they have played a card they can either
    attack the enemies cards or the enemy directly depending on wether the opponent
    also has cards in play in their slots.\n\nIf the opponent has played any cards
    the player can attack the opponents cards by first clicking(with the left mouse
    button) their own card that they want to attack with then selecting the opponents
    card they want to attack.\n\nIf the opponent has not played any cards or doesnt
    have any in the slots they own the player can attack the opponent by first clicking(with
    the left mouse button) their own card that they want to attack with then selecting
    the opponent's hero card(the top right box) \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
